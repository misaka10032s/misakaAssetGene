#!/bin/sh
# Pre-commit gate - runs the COMMIT level of whichever stack(s) the commit actually touches
# (frontend/ -> JS/TS `npm run gate:commit` = `quality-gates/frontend/commit.mjs`, core/|tests/|scripts/|pyproject.toml ->
# Python `quality-gates/python/run.py commit`), derived from the staged file list. Commit = per stack only the steps the
# staged files' change class needs (staged-file lint, determinism of the staged test, setup and gate files, the assertion
# check), no test run, within 10 seconds. The touched stacks run at the same time, so a commit takes about the slowest one,
# not the sum. End of the task (before merge) = the task's one full run (JS/TS `npm run gate:l1`, Python
# `quality-gates/python/run.py l1`; `gate:l0` / `run.py l0` are its first part). Every touched stack is evaluated before the
# hook decides pass/fail - a failure in one stack does NOT skip checking the other (see the "checked: | skipped:" summary
# line at the end).
# Adapted from misaka_site2.0's/mapleStoryAPI's .githooks/pre-commit (verified recipe), extended to a hybrid repo.
#
# Enable once per clone/machine:
#   git config core.hooksPath .githooks
# (core.hooksPath is local, per-clone config - it does NOT travel with the repo, so a fresh
# clone or a new machine has this hook silently absent until the command above is run again.)
#
# `if ! cmd; then ...` (not `cmd; if [ $? -ne 0 ]; then ...`) throughout - under `set -e`, a
# bare `cmd` failing exits the whole script immediately, before its own `$?` check ever runs;
# `if ! cmd` puts the command in `if`'s test position, which `set -e` does not apply to.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

checked=""
skipped=""
failed=0

# True when a staged path matches one of the given pathspecs, or one of the paths that every block also watches: any
# requirements*.txt, any file under any quality-gates/ folder (every extension), any determinism canary file, this hook
# itself, and the test config (conftest.py, pytest.ini, pyproject.toml, vite/vitest config, package.json) - so a change
# to a checker, its canaries, a dependency pin, the hook or a test config cannot drop a check unseen.
staged_matches() {
  git diff --cached --name-only --diff-filter=ACMRD -- "$@" '*requirements*.txt' '*quality-gates/*' '*determinism-canaries/*' '.githooks/*' '*conftest.py' 'pytest.ini' 'pyproject.toml' 'vite.config.*' 'vitest.config.*' 'package.json' | grep -q .
}

# Each fired block runs in the background with its output in its own log and its exit code in its own .rc file; one
# `wait` ends them all, then the logs are printed in the block order (JS/TS, Python), so the output is not mixed.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
blocks=""

start_block() {
  name=$1
  shift
  ( rc=0; "$@" > "$tmp/$name.log" 2>&1 || rc=$?; echo "$rc" > "$tmp/$name.rc" ) &
  blocks="$blocks $name"
}

# --- JS/TS (commit level: quality-gates/frontend/commit.mjs classes the staged files and runs lint, determinism of the staged test/setup/gate files, the assertion check) ---
frontend_block() {
  echo "[pre-commit] frontend/ or determinism-scope changes staged - running JS/TS gate:commit..."
  if ! npm run gate:commit; then
    echo "[pre-commit] JS/TS gate:commit FAILED."
    return 1
  fi
  echo "[pre-commit] JS/TS gate:commit PASSED."
}
if staged_matches 'frontend/*'; then
  start_block frontend frontend_block
  checked="$checked frontend"
else
  echo "[pre-commit] no frontend/ or determinism-scope changes staged - skipping JS/TS gate:commit."
  skipped="$skipped frontend"
fi

# --- Python (commit level: run.py commit classes the staged files and runs ruff on the staged files, determinism of the staged test/setup/gate files, the assertion check) ---
python_block() {
  echo "[pre-commit] core/tests/scripts/determinism-scope changes staged - running Python quality-gates commit..."
  if ! .venv/Scripts/python.exe quality-gates/python/run.py commit; then
    echo "[pre-commit] Python gate commit FAILED."
    return 1
  fi
  echo "[pre-commit] Python gate commit PASSED."
}
if staged_matches 'core/*' 'tests/*' 'scripts/*'; then
  start_block python python_block
  checked="$checked python"
else
  echo "[pre-commit] no core/tests/scripts/determinism-scope changes staged - skipping Python gate commit."
  skipped="$skipped python"
fi

wait
for name in $blocks; do
  cat "$tmp/$name.log"
  rc=$(cat "$tmp/$name.rc" 2>/dev/null || echo 1)
  if [ "$rc" != "0" ]; then
    failed=1
  fi
done
rm -rf "$tmp"

echo "[pre-commit] checked:${checked:- none} | skipped:${skipped:- none}"

if [ "$failed" -ne 0 ]; then
  echo "[pre-commit] one or more stacks FAILED - commit blocked. Fix the above and retry, or --no-verify to bypass (discouraged, logged as a rule violation)."
  exit 1
fi

exit 0
