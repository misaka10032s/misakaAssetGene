{
  "name": "misaka-asset-gene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup.ps1",
    "dev": "cross-env VITE_MISAKA_ENV=dev vite --mode development --config frontend/vite.config.ts",
    "dev:core": "cross-env MISAKA_ENV=dev .venv\\Scripts\\python -m uvicorn core.main:app --reload --port 8401",
    "start:dev": "cross-env MISAKA_ENV=dev VITE_MISAKA_ENV=dev .venv\\Scripts\\python scripts\\dev_stack.py",
    "desktop:dev": "tauri dev",
    "desktop:info": "tauri info",
    "doctor": "cross-env MISAKA_ENV=dev .venv\\Scripts\\python scripts\\doctor.py",
    "manager": "cross-env MISAKA_ENV=dev .venv\\Scripts\\python scripts\\lib\\manager.py",
    "build": "cross-env VITE_MISAKA_ENV=production vite build --mode production --config frontend/vite.config.ts",
    "typecheck": "cross-env VITE_MISAKA_ENV=dev vue-tsc --project frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gate:g1": "node quality-gates/frontend/check-lint-diff.mjs",
    "gate:g2": "node quality-gates/frontend/check-typecheck-baseline.mjs",
    "gate:g2:update-baseline": "node quality-gates/frontend/check-typecheck-baseline.mjs --update-baseline",
    "gate:g3:test": "vitest run",
    "gate:g3:assertions": "node quality-gates/frontend/check-test-assertions.mjs",
    "gate:g3": "npm run gate:g3:test && npm run gate:g3:assertions",
    "gate:g4": "node quality-gates/frontend/check-import-cycles.mjs",
    "gate:g4:update-baseline": "node quality-gates/frontend/check-import-cycles.mjs --update-baseline",
    "gate:g5": "vitest run --coverage && node quality-gates/frontend/diff-coverage.mjs",
    "gate:g6": "node quality-gates/frontend/mutation-diff.mjs",
    "gate:l0": "npm run gate:g1 && npm run gate:g2 && npm run gate:g3 && npm run gate:g4",
    "gate:l1": "npm run gate:l0 && npm run gate:g5 && npm run gate:g6"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.15.18",
    "@unocss/reset": "^66.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^7.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "unocss": "^66.1.0",
    "vite": "^5.4.18",
    "vite-plugin-vue-inspector": "^5.4.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.10"
  }
}
