OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISAKA_ENV=dev
MISAKA_API_HOST=127.0.0.1
MISAKA_API_PORT=8401
MISAKA_API_BASE=http://127.0.0.1:8401
MISAKA_FRONTEND_PORT=8400
# 待回答 #47 — extra Origin values allowed by core/network/origin_guard.py
# (and mirrored into CORS) beyond the built-in loopback (127.0.0.1/localhost/
# [::1] on the frontend+API ports) and Tauri default origins. Comma-separated
# exact "scheme://host:port" strings, e.g.:
# MISAKA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MISAKA_ALLOWED_ORIGINS=
MISAKA_DEFAULT_LOCALE=zh-TW
MISAKA_OLLAMA_BASE_URL=http://127.0.0.1:11434
MISAKA_OLLAMA_MODEL=qwen2.5:7b-instruct
MISAKA_OLLAMA_VISION_MODEL=qwen2.5vl:7b
MISAKA_AUTO_START_OLLAMA=false
MISAKA_LLM_PROVIDER_ORDER=ollama
MISAKA_MODEL_DIR=.model
MISAKA_EXTRA_MODEL_PATHS=
MISAKA_COMFYUI_DEFAULT_CHECKPOINT=novaAnimeXL_ilV180.safetensors
MISAKA_COMFYUI_DEFAULT_NEGATIVE=low quality, worst quality, blurry, jpeg artifacts, bad anatomy, extra limbs, missing limbs, extra fingers, fused fingers, mutated hands, poorly drawn face, poorly drawn hands, watermark, signature, text, logo
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-4-6-sonnet
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash
MISAKA_FIDELITY_SECOND_OPINION=gemini
MISAKA_FIDELITY_PASS_MIN_CONFIDENCE=0.7
VITE_MISAKA_ENV=dev
VITE_MISAKA_API_BASE=http://127.0.0.1:8401
VITE_MISAKA_DEFAULT_LOCALE=zh-TW
